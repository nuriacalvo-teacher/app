{
  "rules": {
    ".read": false,
    ".write": false,
    "irregular_verbs": {
      "$codigo": {
        ".read": "auth != null && (auth.token.email === 'nuria.calvo@iesgoya.es')",
        "$uid": {
          ".read": "auth != null && ($uid === auth.uid || (auth.token.email === 'nuria.calvo@iesgoya.es'))",
          "profile": {
            ".write": "auth != null && $uid === auth.uid && $codigo.matches(/^(1ESO-PWDJ|2ESO-XH9J|E3AB|E3BC|4ESO-XAXD|1BTO-976F|2BTO-KMJR)$/)",
            ".validate": "newData.hasChildren(['firstName','lastName','grade'])"
          },
          "attempts": {
            "$intento": {
              ".write": "auth != null && $uid === auth.uid && !data.exists() && newData.exists() && $codigo.matches(/^(1ESO-PWDJ|2ESO-XH9J|E3AB|E3BC|4ESO-XAXD|1BTO-976F|2BTO-KMJR)$/)",
              ".validate": "newData.hasChildren(['firstName','lastName','grade','moduleId','score'])"
            }
          }
        }
      }
    },
    "irregular_verbs_3en1": {
      "$codigo": {
        ".read": "auth != null && (auth.token.email === 'nuria.calvo@iesgoya.es')",
        "$uid": {
          ".read": "auth != null && ($uid === auth.uid || (auth.token.email === 'nuria.calvo@iesgoya.es'))",
          "profile": {
            ".write": "auth != null && $uid === auth.uid && $codigo.matches(/^(1ESO-PWDJ|2ESO-XH9J|E3AB|E3BC|4ESO-XAXD|1BTO-976F|2BTO-KMJR)$/)",
            ".validate": "newData.hasChildren(['firstName','lastName','grade'])"
          },
          "attempts": {
            "$intento": {
              ".write": "auth != null && $uid === auth.uid && !data.exists() && newData.exists() && $codigo.matches(/^(1ESO-PWDJ|2ESO-XH9J|E3AB|E3BC|4ESO-XAXD|1BTO-976F|2BTO-KMJR)$/)",
              ".validate": "newData.hasChildren(['firstName','lastName','grade','moduleId','score'])"
            }
          }
        }
      }
    },
    "$resto_de_apps": {
      ".read": true,
      ".write": true
    }
  }
}
