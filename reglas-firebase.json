{
  "rules": {
    ".read": false,
    ".write": false,
    "irregular_verbs": {
      ".read": "auth != null && (auth.token.email === 'nuria.calvo@iesgoya.es')",
      "$codigo": {
        "$uid": {
          ".read": "auth != null && $uid === auth.uid",
          "profile": {
            ".write": "auth != null && $uid === auth.uid && auth.token.email.endsWith('@iesgoya.es') && $codigo.matches(/^(1ESO-PWDJ|2ESO-XH9J|3ESO-AB-7HML|3ESO-BC-UAVE|4ESO-XAXD|1BTO-976F|2BTO-KMJR)$/)",
            ".validate": "newData.hasChildren(['firstName','lastName','grade'])"
          },
          "attempts": {
            "$intento": {
              ".write": "auth != null && $uid === auth.uid && auth.token.email.endsWith('@iesgoya.es') && $codigo.matches(/^(1ESO-PWDJ|2ESO-XH9J|3ESO-AB-7HML|3ESO-BC-UAVE|4ESO-XAXD|1BTO-976F|2BTO-KMJR)$/) && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['firstName','lastName','grade','moduleId','score'])"
            }
          }
        }
      }
    },
